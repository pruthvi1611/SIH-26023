# ==============================================================================
# Mining Document Intelligence & Reporting Platform (SIH 2026 - PS 26023)
# Global Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Mining Document Intelligence Platform"
API_VERSION="v1"

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mining_doc_db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vector Search (FAISS)
FAISS_INDEX_PATH=./storage/faiss_index/mining_docs.index
FAISS_METADATA_PATH=./storage/faiss_index/mining_docs_metadata.pkl

# File Storage Configuration
UPLOAD_DIRECTORY=./storage/uploads
PROCESSED_DIRECTORY=./storage/processed
MAX_UPLOAD_SIZE_MB=50

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
