# Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Mining Document Intelligence API"
API_VERSION="v1"

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini API (Backend Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mining_doc_db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage & FAISS
UPLOAD_DIRECTORY=./storage/uploads
PROCESSED_DIRECTORY=./storage/processed
FAISS_INDEX_PATH=./storage/faiss_index/mining_docs.index
FAISS_METADATA_PATH=./storage/faiss_index/mining_docs_metadata.pkl
